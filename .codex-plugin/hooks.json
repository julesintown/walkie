{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/walkie-hook\" ready"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/walkie-hook\" prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/walkie-hook\" tool"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 150,
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/walkie-hook\" ask"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 150,
            "command": "sh \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/walkie-hook\" stop"
          }
        ]
      }
    ]
  }
}
